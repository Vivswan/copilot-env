#!/bin/sh
# Single self-bootstrapping entry point (Linux + macOS) for copilot-env.
# Installs deno if missing (the .dvmrc pin, via the shared scripts/ensure-deno.sh that
# scripts/setup-env.sh uses too), installs dependencies in-place in the checkout only when
# the lockfile has moved ahead of them, then runs the cli.ts dispatcher (cli.ts owns the
# subcommand list; see `agent --help`). The `agent` shell function (agents.bashrc) is what
# turns `agent env` output into shell state.
#
# No cache: node_modules lives directly in the checkout and cli.ts runs from there.
#
# EVERY line this script emits goes to stderr -- stdout belongs to `agent env`, whose
# output the shell function evals.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
SNAP="$(cd "${HERE}/.." && pwd)"

# shellcheck source=../scripts/ensure-deno.sh
. "${SNAP}/scripts/ensure-deno.sh"
if ! ensure_deno "${SNAP}"; then
    echo "copilot-env bootstrap failed: deno is unavailable -- check network, then re-run." >&2
    exit 1
fi

# Install dependencies in-place in the checkout, but only when needed: a missing
# node_modules, or a deno.lock that has moved ahead of it (the lockfile is the source of
# truth for what should be installed, and every dependency change updates it).
if [ ! -d "${SNAP}/node_modules" ] || [ "${SNAP}/deno.lock" -nt "${SNAP}/node_modules" ]; then
    if ! ( cd "${SNAP}" && deno install --frozen >&2 ); then
        echo "copilot-env bootstrap failed: deno install did not complete -- check network/deno, then re-run." >&2
        exit 1
    fi
    # Mark node_modules as freshly installed so the deno.lock-vs-node_modules mtime
    # check above can't loop: a no-op frozen install needn't bump the dir's mtime.
    touch "${SNAP}/node_modules"
fi

# Opt-in autoupdate preflight: ONLY on `agent start`, run before cli.ts loads so a
# swapped release is what dispatches. preflight.ts gates on the state file's
# `enabled` flag and the once-per-day cadence; the file-exists test just keeps the
# no-spawn fast path for users who never opted in. Non-fatal; output to stderr.
# `-P=cli` scopes net to the CLI's real outbound hosts; fs/run stay broad until chunk 5.
if [ "${1:-}" = "start" ] && [ -f "${SNAP}/.autoupdate/state.json" ]; then
    deno run -P=cli "${SNAP}/src/autoupdate/preflight.ts" >&2 || true
fi

exec deno run -P=cli "${SNAP}/src/cli.ts" "$@"
