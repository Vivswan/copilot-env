  "lint-staged": {
    "src/**/*.ts": ["deno lint --fix", "deno fmt"],
    "test/**/*.ts": ["deno lint --fix", "deno fmt"],
    "scripts/**/*.ts": ["deno lint --fix", "deno fmt"],
    ".github/scripts/**/*.ts": ["deno lint --fix", "deno fmt"],
    "deno.json": "deno fmt"
  }
}
