#!/bin/sh
# Self-bootstrapping entry point (Linux + macOS); bin/agent.ps1 is the Windows twin.
# Every line this script emits goes to stderr: stdout belongs to `agent profile env`, which the
# `agent` shell function in shell/agents.bashrc evals.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
SNAP="$(cd "${HERE}/.." && pwd)"

# shellcheck source=../scripts/ensure-deno.sh
. "${SNAP}/scripts/ensure-deno.sh"
# `agent profile env` is the wrapper's automatic refresh after every command: its
# bootstrap runs quiet so an old PATH deno warns once per command, not twice.
if ! ensure_deno "${SNAP}" "$([ "${1:-}" = "profile" ] && [ "${2:-}" = "env" ] && echo quiet)"; then
    echo "copilot-env bootstrap failed: deno is unavailable -- check network, then re-run." >&2
    exit 1
fi

# `find -prune -newer` is the freshness test: POSIX sh does not define `[ a -nt b ]`.
# A failed read reinstalls (the self-healing direction) rather than reading as "deps current".
deps_proven_current() {
    [ -d "${SNAP}/node_modules" ] || return 1
    newer="$(find "${SNAP}/deno.lock" -prune -newer "${SNAP}/node_modules" 2>/dev/null)" || return 1
    [ -z "${newer}" ]
}
if ! deps_proven_current; then
    if ! ( cd "${SNAP}" && deno install --frozen >&2 ); then
        echo "copilot-env bootstrap failed: deno install did not complete -- check network/deno, then re-run." >&2
        exit 1
    fi
    # Mark node_modules as freshly installed so the deno.lock-vs-node_modules mtime
    # check above can't loop: a no-op frozen install needn't bump the dir's mtime.
    touch "${SNAP}/node_modules"
fi

# -q drops Deno's own "Permissions in the config file is an experimental feature" line, printed
# for -P on every command; its errors and the CLI's stderr still print.
exec deno run -q -P=cli "${SNAP}/src/cli.ts" "$@"
