#!/bin/sh
# Wired by scripts/setup-env.sh (.ps1 on Windows) through core.hooksPath; deno-native, so no
# node. The same gate as the `check` job in .github/workflows/checks.yml.
set -e
# The one-time deno install dir is only a FALLBACK: a deno already on PATH wins.
PATH="$PATH:${DENO_INSTALL:-$HOME/.deno}/bin"
export PATH
deno task lint:staged
deno task typecheck
deno task test
deno task lint
deno task lint:sh
deno task lint:ps
