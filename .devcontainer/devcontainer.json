{
  "name": "copilot-env",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "bash scripts/setup-env.sh",
  "containerEnv": {
    "BUN_INSTALL": "/home/vscode/.bun"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:BUN_INSTALL}/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["oven.bun-vscode"]
    }
  }
}
