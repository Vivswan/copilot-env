{
  "name": "copilot-env",
  "version": "5.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local copilot-api proxy lifecycle + config helper (TypeScript port of the Python copilot-api helper).",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run knip",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p .",
    "test": "bun scripts/run_tests.ts",
    "build": "bun scripts/compile.ts",
    "install:local": "bun scripts/install_local.ts",
    "test:docker": "bun scripts/test_docker.ts",
    "docs:arch": "bun scripts/docs_arch.ts",
    "lint:sh": "bun scripts/lint_shell.ts sh",
    "lint:ps": "bun scripts/lint_shell.ts ps",
    "bench": "bun bench/usage_index.bench.ts",
    "usage:profile": "bun scripts/usage/profile.ts",
    "usage:fixtures": "bun scripts/usage/fixtures.ts",
    "usage:goldens": "bun scripts/usage/goldens.ts",
    "usage:corpus": "bun scripts/usage/corpus.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@copilotkit/aimock": "1.43.0",
    "@jeffreycao/copilot-api": "^2.6.19",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@modelcontextprotocol/server": "^2.1.0",
    "@octokit/auth-oauth-device": "^8.0.5",
    "@octokit/request": "^10.0.16",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/tuf": "^5.0.0",
    "@sigstore/verify": "^4.1.2",
    "@std/async": "npm:@jsr/std__async@^1.5.1",
    "@std/dotenv": "npm:@jsr/std__dotenv@^0.225.8",
    "@std/semver": "npm:@jsr/std__semver@^1.0.8",
    "@std/yaml": "npm:@jsr/std__yaml@^1.3.0",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "memfs": "4.79.0",
    "smol-toml": "^1.9.0",
    "string-width": "^8.2.2",
    "undici": "^8.11.2",
    "undici7": "npm:undici@^7.29.1",
    "valibot": "^1.5.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "knip": "6.41.0",
    "mitata": "1.0.34",
    "oxc-parser": "0.153.0",
    "typescript": "7.0.2"
  }
}
