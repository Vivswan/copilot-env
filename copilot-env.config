# Build-time constants read out of the binary: the proxy-float version bounds (src/proxy_float.ts
# + start.ts) and the deno sidecar's tested reference version (src/copilot_api/sidecar.ts).
# Format: KEY=value. An empty MAX means "no ceiling"; "null" is also accepted.
PROXY_MIN_VERSION=2.2.2
PROXY_MAX_VERSION=
SIDECAR_DENO_VERSION=2.9.7
