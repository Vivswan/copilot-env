#!/bin/sh
# Wired by scripts/setup-env.sh (.ps1 on Windows) through core.hooksPath. Bun's own checks only,
# and only the unit tests: the *.e2e.test.ts files spawn processes and set up home-shaped
# sandboxes, so they run in CI (the `check` job in .github/workflows/checks.yml), which also runs
# the shell linters (shellcheck, PSScriptAnalyzer), separately installed tools.
#
# A hook installs nothing: a missing bun or node_modules fails here, naming the one-time
# bootstrap, instead of being fetched by the first task.
set -e
# The one-time bun install dir is only a FALLBACK: a bun already on PATH wins.
PATH="$PATH:${BUN_INSTALL:-$HOME/.bun}/bin"
export PATH
bootstrap="run scripts/setup-env.sh (scripts/setup-env.ps1 on Windows) once"
if ! command -v bun > /dev/null 2>&1; then
    echo "pre-commit: bun is not installed; $bootstrap" >&2
    exit 1
fi
if [ ! -d node_modules ]; then
    echo "pre-commit: node_modules is missing; $bootstrap" >&2
    exit 1
fi
bun run typecheck
bun run lint
bun run test:unit
