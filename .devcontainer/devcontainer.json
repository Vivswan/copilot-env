{
  "name": "copilot-env",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "bash scripts/setup-env.sh",
  "containerEnv": {
    "DENO_INSTALL": "/home/vscode/.deno"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:DENO_INSTALL}/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["denoland.vscode-deno"]
    }
  }
}
